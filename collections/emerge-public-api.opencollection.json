              {
                "name": "organization-id",
                "value": "070C895C-AE61-4629-A603-829FC54CD816"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This method gives the ability to the shipper organization to invite it's network partner to the Emerge platform."
        },
        {
          "info": {
            "name": "Deletes a network partner from Emerge platform.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.emergemarket.io/v1/network_partners/:partner_id",
