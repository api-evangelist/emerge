                "value": "070C895C-AE61-4629-A603-829FC54CD816"
              }
            ],
            "params": [
              {
                "name": "partner_id",
                "value": "",
                "type": "path",
                "description": "ID of the network partner."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This method gives the ability to a shipper organization to delete it's network partner from the Emerge platform."
