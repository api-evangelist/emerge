  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Gets access token for shipper user.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.emergemarket.io/v1/auth/login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This method allows the shipper user to generate an access token from Emerge platform. This access token is based upon a username/password combination that should be supplied in the request. Authentication has a rate limit of up to 20 requests per second. This limit may be lower during times of high volumes."
        },
        {
          "info": {
            "name": "Gets a refreshed access token for shipper user.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.emergemarket.io/v1/auth/refresh",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This method allows users to refresh their access token based upon the original authentication event."
        }
      ]
    },
    {
      "info": {
        "name": "Network Partners",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Gets all active network partners associated with the shipper organization.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.emergemarket.io/v1/network_partners",
            "headers": [
              {
                "name": "organization-id",
                "value": "070C895C-AE61-4629-A603-829FC54CD816"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This method gives the ability to a shipper organization to view its active network partners in the Emerge system."
        },
        {
          "info": {
            "name": "Invites a network partner to Emerge platform.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.emergemarket.io/v1/network_partners",
